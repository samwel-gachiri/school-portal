{
    "name": "school-portal-backend",
    "version": "1.0.0",
    "description": "AI-powered school fee payment portal backend",
    "main": "dist/server.js",
    "scripts": {
        "dev": "nodemon src/server-simple.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "start:prod": "NODE_ENV=production node dist/server.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "migrate": "liquibase update",
        "lint": "eslint src/**/*.ts",
        "lint:fix": "eslint src/**/*.ts --fix",
        "clean": "rimraf dist",
        "prebuild": "npm run clean",
        "postbuild": "cp -r migrations dist/ && cp ecosystem.config.js dist/",
        "docker:build": "docker build -t school-portal-backend .",
        "docker:run": "docker run -p 3000:3000 --env-file .env school-portal-backend"
    },
    "dependencies": {
        "express": "^4.18.2",
        "cors": "^2.8.5",
        "helmet": "^7.1.0",
        "mysql2": "^3.6.5",
        "bcrypt": "^5.1.1",
        "jsonwebtoken": "^9.0.2",
        "multer": "^1.4.5-lts.1",
        "openai": "^4.20.1",
        "dotenv": "^16.3.1",
        "joi": "^17.11.0",
        "winston": "^3.11.0",
        "morgan": "^1.10.0",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/cors": "^2.8.17",
        "@types/bcrypt": "^5.0.2",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/multer": "^1.4.11",
        "@types/morgan": "^1.9.9",
        "@types/uuid": "^9.0.7",
        "@types/node": "^20.10.0",
        "rimraf": "^5.0.5",
        "typescript": "^5.3.2",
        "nodemon": "^3.0.2",
        "ts-node": "^10.9.1",
        "jest": "^29.7.0",
        "@types/jest": "^29.5.8",
        "ts-jest": "^29.1.1",
        "supertest": "^6.3.3",
        "@types/supertest": "^2.0.16"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}