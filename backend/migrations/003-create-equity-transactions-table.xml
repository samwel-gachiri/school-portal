<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="003-create-equity-transactions-table" author="system">
        <createTable tableName="equity_transactions">
            <column name="transaction_id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="transaction_ref" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="transaction_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(3)" defaultValue="KES">
                <constraints nullable="false"/>
            </column>
            <column name="depositor_name" type="VARCHAR(255)"/>
            <column name="depositor_mobile" type="VARCHAR(20)"/>
            <column name="payment_description" type="VARCHAR(255)"/>
            <column name="narration" type="TEXT"/>
            <column name="status" type="ENUM('pending', 'matched', 'posted', 'rejected')" defaultValue="pending">
                <constraints nullable="false"/>
            </column>
            <column name="matched_student_adm" type="INT"/>
            <column name="matched_by_user_id" type="INT"/>
            <column name="matched_at" type="TIMESTAMP"/>
            <column name="posted_payment_id" type="INT"/>
            <column name="rejection_reason" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="equity_transactions" indexName="idx_transaction_ref">
            <column name="transaction_ref"/>
        </createIndex>
        
        <createIndex tableName="equity_transactions" indexName="idx_depositor_mobile">
            <column name="depositor_mobile"/>
        </createIndex>
        
        <createIndex tableName="equity_transactions" indexName="idx_status">
            <column name="status"/>
        </createIndex>
        
        <createIndex tableName="equity_transactions" indexName="idx_transaction_date">
            <column name="transaction_date"/>
        </createIndex>
        
        <createIndex tableName="equity_transactions" indexName="idx_matched_student">
            <column name="matched_student_adm"/>
        </createIndex>

        <addForeignKeyConstraint
            baseTableName="equity_transactions"
            baseColumnNames="matched_by_user_id"
            constraintName="fk_equity_transactions_user"
            referencedTableName="user"
            referencedColumnNames="user_id"
            onDelete="SET NULL"/>
    </changeSet>

</databaseChangeLog>
