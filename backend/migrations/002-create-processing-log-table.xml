<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002-create-processing-log-table" author="system">
        <createTable tableName="processing_log">
            <column name="log_id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="action_type" type="ENUM('upload', 'extract', 'match', 'confirm', 'insert')">
                <constraints nullable="false"/>
            </column>
            <column name="details" type="JSON">
                <constraints nullable="true"/>
            </column>
            <column name="timestamp" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="processing_log"
            baseColumnNames="user_id"
            constraintName="fk_processing_log_user_id"
            referencedTableName="user"
            referencedColumnNames="user_id"
            onDelete="CASCADE"/>

        <createIndex tableName="processing_log" indexName="idx_processing_log_user_id">
            <column name="user_id"/>
        </createIndex>

        <createIndex tableName="processing_log" indexName="idx_processing_log_timestamp">
            <column name="timestamp"/>
        </createIndex>

        <createIndex tableName="processing_log" indexName="idx_processing_log_action_type">
            <column name="action_type"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>