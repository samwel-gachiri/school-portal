{
    "name": "school-portal-frontend",
    "version": "1.0.0",
    "description": "AI-powered school fee payment portal frontend",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc && vite build",
        "build:prod": "vite build --mode production",
        "build:check": "vue-tsc && vite build --mode production",
        "preview": "vite preview",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
        "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path .gitignore",
        "type-check": "vue-tsc --noEmit",
        "clean": "rimraf dist",
        "prebuild": "npm run clean && npm run type-check",
        "docker:build": "docker build -t school-portal-frontend .",
        "docker:run": "docker run -p 80:80 school-portal-frontend"
    },
    "dependencies": {
        "@headlessui/vue": "^1.7.16",
        "@heroicons/vue": "^2.0.18",
        "axios": "^1.6.2",
        "exceljs": "^4.4.0",
        "file-saver": "^2.0.5",
        "pinia": "^2.1.7",
        "vue": "^3.3.8",
        "vue-router": "^4.2.5",
        "vue-toastification": "^2.0.0-rc.5",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@types/file-saver": "^2.0.7",
        "@types/node": "^20.10.0",
        "@vitejs/plugin-vue": "^4.5.0",
        "@vue/eslint-config-typescript": "^12.0.0",
        "@vue/test-utils": "^2.4.2",
        "@vue/tsconfig": "^0.4.0",
        "autoprefixer": "^10.4.16",
        "eslint": "^8.54.0",
        "eslint-plugin-vue": "^9.18.1",
        "jsdom": "^23.0.1",
        "postcss": "^8.4.32",
        "rimraf": "^5.0.5",
        "tailwindcss": "^3.3.6",
        "typescript": "~5.3.0",
        "vite": "^5.0.0",
        "vite-plugin-pwa": "^0.17.4",
        "vitest": "^1.0.0",
        "vue-tsc": "^1.8.22"
    },
    "optionalDependencies": {
        "@esbuild/win32-x64": "^0.25.9",
        "@rollup/rollup-darwin-x64": "^4.0.0",
        "@rollup/rollup-linux-x64-gnu": "^4.0.0",
        "@rollup/rollup-win32-x64-msvc": "^4.0.0"
    }
}
